# -------------------------------------------------------------
# SUPABASE / PRISMA DATABASE CONFIGURATION
# -------------------------------------------------------------
# In your Supabase project: Settings -> Database -> Connection string
# 1. DATABASE_URL: Transaction Mode (Port 6543) for connection pooling
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Session Mode (Port 5432) for direct migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional Supabase API keys (if using Supabase Auth or Storage)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGci..."

# -------------------------------------------------------------
# FIREBASE CONFIGURATION (OPTIONAL)
# -------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
